node_modules/

# Real credentials. .env.example is tracked on purpose and must stay that way,
# so the ignore is written per-file rather than as a blanket .env* — that would
# swallow the example and leave a fresh clone with nothing to copy from.
.env
.env.local
.env.*.local

# Next.js build output and the incremental type-check cache — both regenerate,
# and .next in particular is large and machine-specific.
.next/
out/
tsconfig.tsbuildinfo

# Vercel CLI link state — machine-local, points at one account's project.
.vercel

dist/
storage/
*.log
.DS_Store
Thumbs.db

# Scratch scripts used while debugging; the real ones are checked in by name.
scripts/_*
graphify-out/

# Local scratch space — probe scripts, screenshots, dev logs.
# Nothing here is part of the build or the history.
scratchpad/
