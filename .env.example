# Supabase — create a NEW project, then Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# service_role key. Server/CLI only. Never ship to a browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Optional: LLM fallback for attribute extraction the rules cannot resolve.
# Leave unset to run rules-only (the pipeline degrades gracefully).
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# Crawl politeness
CRAWL_USER_AGENT=ProductFinderBot/0.1 (+internal catalogue research; contact: gyanendu1197@gmail.com)
CRAWL_DELAY_MS=1200
CRAWL_MAX_RETRIES=3

# Direct Postgres URI — only needed for `npm run migrate`.
# Settings > Database > Connection string > URI. URL-encode @ : / ? # % in the password.
SUPABASE_DB_URL=

# Publishable/anon key — safe in a browser, cannot write. For the future dashboard.
SUPABASE_PUBLISHABLE_KEY=

# Protects POST /api/crawl (the "Run crawl now" button). If unset the endpoint is
# open to anyone who can reach the site — fine locally, NOT fine once deployed.
CRAWL_TRIGGER_TOKEN=
